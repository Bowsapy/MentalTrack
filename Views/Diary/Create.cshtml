@model MentalTrack.Models.JournalEntry

<div class="d-flex justify-content-center mt-5">
    <div class="card shadow-lg p-5 rounded-3" style="max-width: 700px; width: 100%;">
        <h2 class="mb-4 text-center text-primary">New Entry</h2>

        <form asp-action="Create" method="post">
            <div class="mb-3">
                <label asp-for="Title" class="form-label fw-semibold">Title</label>
                <input asp-for="Title" class="form-control"  value= "Your title of entry" placeholder="What's on your mind?" />
            </div>

            <div class="mb-3">
                <label asp-for="Content" class="form-label fw-semibold">Content</label>
                <textarea asp-for="Content" class="form-control" rows="20" placeholder="Describe what you did during the day...(Make sure to separate sentences with periods)"></textarea>
            </div>

            <div class="mb-4">
                <label asp-for="Mood" class="form-label fw-semibold">Mood</label>
                <select asp-for="Mood" class="form-select" asp-items="Html.GetEnumSelectList<MoodEnum>()">
                    <option value="">How did you feel for most of the day?</option>
                </select>
            </div>

            <div class="text-center">
                <button type="submit" class="btn btn-primary btn-lg shadow-sm">Save Entry</button>
            </div>
        </form>
    </div>
</div>