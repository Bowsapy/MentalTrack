@model List<JournalEntry>



<body class="grass-background">


<div class="similar-entries-pag">

        <div class="similar-entries-header bg-white text-black padded-container bordered">
        <div>
            <h1>Similar Entries</h1>
            <p>Journal entries that share similar thoughts, feelings and experiences.</p>
        </div>



  
    </div>
    <div class="entries-wrapper">

        @foreach (var entry in Model)
        {
            <article class="entry-card">

                <div class="entry-card-top">
                    <div class="entry-title">
                        @entry.Title
                    </div>
                    
                    <span class="entry-mood @MoodHelper.GetMoodBadgeBG(entry.Mood) text-white">
                        @entry.Mood.GetDisplayName()
                    </span>
                    
                </div>


                <div class="entry-content">
                    @entry.Content
                </div>
                <div>
                
                    @entry.CreatedAt
                      
                </div>



            </article>
        }

    </div>

</div>
</body>

<style>


/* =========================
SIMILAR ENTRIES
========================= */

.similar-entries-page {
width: min(1100px, 92%);
margin: 60px auto;
}


/* HEADER */

.similar-entries-header {
display: flex;
justify-content: space-between;
align-items: flex-end;

margin-bottom: 35px;
}

.section-label {
font-size: 0.75rem;
letter-spacing: 3px;
font-weight: 700;
color: #7c8a7c;
}



/* CARDS */

.entries-wrapper {
display: grid;
grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
gap: 24px;
}


.entry-card {
position: relative;

display: flex;
flex-direction: column;

min-height: 270px;

padding: 28px;

background-color:white;

border: 1px solid rgba(80, 100, 85, 0.12);
border-radius: 18px;

box-shadow:
0 10px 30px rgba(50, 70, 55, 0.07);

transition:
transform 0.25s ease,
box-shadow 0.25s ease,
border-color 0.25s ease;
}


.entry-card:hover {
transform: translateY(-5px);

border-color: rgba(80, 110, 85, 0.3);

box-shadow:
0 18px 40px rgba(50, 70, 55, 0.13);
}


/* TITLE + MOOD */

.entry-card-top {
display: flex;
justify-content: space-between;
align-items: flex-start;

gap: 20px;

margin-bottom: 20px;
}

.entry-title {
font-size: 1.35rem;
font-weight: 700;

line-height: 1.3;

color: #29372e;
}


/* CONTENT */

.entry-content {
flex: 1;

color: #68736b;

line-height: 1.7;
font-size: 0.98rem;

display: -webkit-box;
-webkit-line-clamp: 6;
-webkit-box-orient: vertical;

overflow: hidden;
}


/* MOOD */

.entry-mood {
flex-shrink: 0;

padding: 7px 13px;

border-radius: 999px;

font-size: 0.75rem;
font-weight: 700;

text-transform: uppercase;
letter-spacing: 0.5px;
}


/* MOO


/* FOOTER */

.entry-card-footer {
display: flex;
justify-content: space-between;
align-items: center;

margin-top: 25px;
padding-top: 18px;

border-top: 1px solid rgba(80, 100, 85, 0.1);

color: #9aa39c;

font-size: 0.78rem;
}


.entry-arrow {
display: flex;
align-items: center;
justify-content: center;

width: 30px;
height: 30px;

border-radius: 50%;

background: #eef3ee;

color: #4d6954;

font-size: 1.1rem;

transition: transform 0.2s ease;
}


.entry-card:hover .entry-arrow {
transform: translateX(4px);
}



@@media (max-width: 600px) {

.similar-entries-page {
width: 94%;
margin: 35px auto;
}

.similar-entries-header {
align-items: flex-start;
gap: 20px;
}

.entries-count {
display: none;
}

.entries-wrapper {
grid-template-columns: 1fr;
}

.entry-card {
padding: 22px;
}

.entry-card-top {
flex-direction: column;
gap: 12px;
}

.entry-mood {
align-self: flex-start;
}
}
</style>
