@using System.Text.Json
@model List<UserstatesProgressViewModel>

 <body class="grass-background">


<div class="container mt-4">

    <div class="card shadow-sm border-0">

        <div class="card-body">

            <h3 class="mb-4">
                Activities & Feelings Heatmap
            </h3>

            <div style="height:700px; background-color:whitesmoke" >
                <canvas id="userStatesHeatmap"></canvas>
            </div>

        </div>

    </div>

</div>
</body>

<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
<script src="https://cdn.jsdelivr.net/npm/chartjs-chart-matrix@2.0.1/dist/chartjs-chart-matrix.min.js"></script>

<script>

    const userStates = @Html.Raw(JsonSerializer.Serialize(Model));

    console.log(userStates);

    const dates = [...new Set(userStates.map(x => x.Date))];
    const states = [...new Set(userStates.map(x => x.State))];

    const ctx = document.getElementById('userStatesHeatmap');

    new Chart(ctx, {

    type: 'matrix',

    data: {

    datasets: [
    {
    label: 'User States',

    data: userStates.map(item => ({
    x: item.Date,
    y: item.State,
    v: item.Value
    })),

    backgroundColor(context) {

    const value = context.dataset.data[context.dataIndex].v;

    if (value == 0)
    return "#f3f4f6";

    if (value == 1)
    return "#86efac";

    if (value == 2)
    return "#4ade80";

    if (value == 3)
    return "#22c55e";

    return "#15803d";
    },

    borderRadius: 6,
    borderWidth: 1,
    borderColor: "#ffffff",

    width(context) {

    const area = context.chart.chartArea;

    return area
    ? area.width / dates.length - 2
    : 28;
    },

    height(context) {

    const area = context.chart.chartArea;

    return area
    ? area.height / states.length - 2
    : 28;
    }
    }
    ]
    },

    options: {

    responsive: true,

    maintainAspectRatio: false,

    animation: {
    duration: 800
    },

    plugins: {

    legend: {
    display: false
    },

    tooltip: {

    callbacks: {

    label(context) {

    const item = context.dataset.data[context.dataIndex];

    return `${item.y} | ${item.x} | Count: ${item.v}`;
    }
    }
    }
    },

    scales: {

    x: {

    type: 'category',

    labels: dates,

    offset: true,

    grid: {
    display: false
    },

    ticks: {
    maxRotation: 45,
    minRotation: 0,
    color: "#212529",
    font: {
    size: 12,
    weight: "bold"
    }
    },

    title: {
    display: true,
    text: 'Date Y/M/D'
    }
    },

    y: {

    ticks: {
    maxRotation: 45,
    minRotation: 0,
    color: "#212529",
    font: {
    size: 11,
    weight: "bold"
    }
    },
    

    type: 'category',

    labels: states,

    offset: true,

    grid: {
    display: false
    },

    title: {
    display: true,
    text: 'Activity / Feeling'
    }
    }
    }
    }
    });

</script>