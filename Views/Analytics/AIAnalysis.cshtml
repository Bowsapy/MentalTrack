@using System.ComponentModel.DataAnnotations
@using System.Reflection
@using MentalTrack.Enums;

@model Dictionary<MoodEnum, Dictionary<UserStateEnum, int>>;

<head>

    <link rel="stylesheet" href="~/css/features.css" asp-append-version="true" />

</head>

<div class="activities">
    <h1><img src="~/images/active-user.png" />  Activities and your mood</h1>
    <p> Mental Track looks for connections between what you write about and your mood. </p>
    @foreach (var item in Model)
    {
        if (item.Value.Count > 0)
        {
            <div class="card">
                <h3>
                    You tend to be in <b>@item.Key.GetDisplayName()</b> mood when you write about:
                </h3>

                <ul>
                    @foreach (var state in item.Value)
                    {
                        <li>
                            <b>@state.Key.GetDisplayName()</b>
                            <span class="tag">@state.Value entry/entries</span>
                        </li>
                    }
                </ul>
            </div>
        }
    }
</div>

<style>

    .activities {
        max-width: 900px;
        margin: 50px auto;
        padding: 20px;
    }

        .activities h1 {
            display: flex;
            align-items: center;
            gap: 15px;
            font-size: 2.3rem;
            font-weight: 700;
            color: #1f2937;
            margin-bottom: 10px;
        }

            .activities h1 img {
                width: 55px;
                height: 55px;
            }

        .activities > p {
            color: #6b7280;
            font-size: 1.1rem;
            margin-bottom: 35px;
        }

        .activities .card {
            background: white;
            border-radius: 22px;
            padding: 28px;
            margin-bottom: 24px;
            box-shadow: 0 12px 30px rgba(0,0,0,.08);
            transition: .25s ease;
            border-left: 8px solid #43a047;
        }

            .activities .card:hover {
                transform: translateY(-4px);
                box-shadow: 0 18px 40px rgba(0,0,0,.12);
            }

        .activities h3 {
            margin-bottom: 18px;
            color: #222;
            font-size: 1.35rem;
            line-height: 1.5;
        }

            .activities h3 b {
                color: #43a047;
            }

        .activities ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

        .activities li {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 14px 0;
            border-bottom: 1px solid #ececec;
        }

            .activities li:last-child {
                border-bottom: none;
            }

    .tag {
        background: linear-gradient(135deg,#43a047,#66bb6a);
        color: white;
        padding: 6px 14px;
        border-radius: 999px;
        font-size: .9rem;
        font-weight: 600;
        box-shadow: 0 4px 10px rgba(67,160,71,.3);
    }

    @@media (max-width:768px) {

        .activities {
            padding: 15px;
        }

            .activities h1 {
                font-size: 1.8rem;
            }

            .activities li {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }

        .tag {
            align-self: flex-start;
        }
    }
</style>