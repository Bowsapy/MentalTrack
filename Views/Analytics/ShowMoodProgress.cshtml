@model MentalTrack.ViewModels.MoodGraphViewModel



@{
    ViewData["Title"] = "Mood Chart";
}

<body class="tree-background">

    <div class="bg-white graph-container"> 
        <div class="view-switch">
            <a asp-action="ShowMoodProgress"
               class="@(Model.description == "All entries" ? "active-graph" : "")">
                All
            </a>

            <a asp-action="ShowMoodProgressMonthly"
               class="@(Model.description == "Your average monthly mood" ? "active-graph" : "")">
                Monthly
            </a>

            <a asp-action="ShowMoodProgressDaily"
               class="@(Model.description == "Your average daily mood" ? "active-graph" : "")">
                Daily
            </a>
        </div>


<div class="container mt-5">
    <h2 class="text-center text-primary mb-4 green-text"> @Model.description</h2>

    <div style="height:400px;">
        <canvas id="moodChart"></canvas>
    </div>
</div>
    </div>
</body>

<!-- Chart.js -->
<script src="https://cdn.jsdelivr.net/npm/chart.js"></script>

<script>
    const labels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.axis_x));
    const moodValuesRaw = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.axis_y));

    // převod string → number (protože Y osa musí být čísla)
    const moodValues = moodValuesRaw.map(x => Number(x));

    const moods = ['Very Bad', 'Bad', 'Neutral', 'Good', 'Very Good'];

    const ctx = document.getElementById('moodChart').getContext('2d');

    const moodChart = new Chart(ctx, {
    type: 'line',
    data: {
    labels: labels,
    datasets: [{
    label: 'Mood',
    data: moodValues,
    backgroundColor: 'rgba(54, 162, 235, 0.2)',
    borderColor: 'rgb(46, 125, 50)',
    borderWidth: 2,
    fill: true,
    tension: 0.3,
    pointRadius: 5,
    pointBackgroundColor: 'rgba(46, 125, 50)'
    }]
    },
    options: {
    scales: {
    y: {
    min: 1,
    max: 5,
    ticks: {
    font: {
    size: 12,
    weight: 'bold'
    },
    color: function(context) {

    const colors = [
    '#7f1d1d', // Very Bad
    '#dc2626', // Bad
    '#0066ff', // Neutral
    '#81C784', // Good
    '#16a34a'  // Very Good
    ];

    return colors[context.tick.value - 1];
    },

    stepSize: 1,

    callback: function(value) {
    return moods[value-1] || value;
    }
    }
    }
    },
    plugins: {
    legend: {
    display: false
    },
    tooltip: {
    callbacks: {
    label: function(context) {
    return moods[context.raw] || context.raw;
    }
    }
    }
    },
    responsive: true,
    maintainAspectRatio: false
    }
    });
</script>

<style>
.graph-container{
    padding:10px;
}


.view-switch{
    display:flex;
    justify-content:center;
    margin:25px 0;
    background:#f3f4f6;
    border-radius:16px;
    padding:6px;
    width:fit-content;
    margin-left:auto;
    margin-right:auto;
    box-shadow:0 4px 12px rgba(0,0,0,.08);
}

.view-switch a{
    text-decoration:none;
    color:#4b5563;
    font-weight:600;
    padding:10px 28px;
    border-radius:12px;
    transition:.25s;
}

.view-switch a:hover{
    background:#e5e7eb;
    color:#1f2937;
	}

    .view-switch a.active-graph {
    background:#2e7d32;
    color:white;
    box-shadow:0 3px 10px rgba(46,125,50,.35);
}


</style>
