

<body class="tree-background">
<div class="analytics-actions">


        <form asp-controller="Analytics" asp-action="AIAnalysis">
            <button class="analytics-card analysis-btn">
                <div class="icon"> <img src="~/images/ai.png" width="50px" height="50px" /></div>
                <div>
                    <h5>Mood x activities</h5>
                    <p>Discover habits affecting your mood.</p>
                </div>
            </button>
        </form>
        <form asp-controller="Analytics" asp-action="USinDay">
            <button class="analytics-card analysis-btn">
                <div class="icon"> <img src="~/images/activities.png" width="50px" height="50px" /></div>
                <div>
                    <h5>Activities summary</h5>
                    <p> Summary of your activities, habits and emotions.</p>
                </div>
            </button>
        </form>

        <form asp-controller="Analytics" asp-action="WordCountAnalysis">
            <button class="analytics-card analysis-btn">
                <div class="icon"> <img src="~/images/word.png" width="50px" height="50px" /></div>
                <div>
                    <h5>Word count analysis</h5>
                    <p>Discover which words are most commonly associated with your moods.</p>
                </div>
            </button>
        </form>

        
        <form asp-controller="Analytics" asp-action="MoodSummary">
            <button class="analytics-card analysis-btn">
                <div class="icon"> <img src="~/images/pie-chart.png" width="50px" height="50px" /></div>
                <div>
                    <h5>Your general stats</h5>
                    <p>Get an overview of your journal entries, mood...</p>
                </div>
            </button>
        </form>


        <form asp-controller="Analytics" asp-action="ShowMoodProgress">
            <button class="analytics-card analysis-btn">
                <div class="icon"> <img src="~/images/graph.png" width="50px" height="50px" /></div>
                <div>
                    <h5>Mood Progress</h5>
                    <p>See how your mood has changed over time.</p>
                </div>
            </button>
        </form>


        <form asp-controller="Analytics" asp-action="MoodInWeek">
            <button class="analytics-card analysis-btn">
                <div class="icon"> <img src="~/images/next-week.png" width="50px" height="50px" /></div>
                <div>
                    <h5>Week Mood Analysis</h5>
                    <p>Discover your average mood in weekdays.</p>
                </div>
            </button>
        </form>

        <form asp-controller="Analytics" asp-action="MoodInDay">
            <button class="analytics-card analysis-btn">
                <div class="icon"> <img src="~/images/clock.png" width="50px" height="50px" /></div>
                <div>
                    <h5>Day Mood Analysis</h5>
                    <p>Discover your average mood in day times.</p>
                </div>
            </button>
        </form>

  
    



</div>

        <a href="https://www.flaticon.com/free-icons/search" title="icons"> Icons created by Magnific - Flaticon</a>
