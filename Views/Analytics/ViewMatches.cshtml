@using MentalTrack.Enums
@model Dictionary<MoodEnum, List<UserStateEnum>>


@*
    pro kazdou mood vypis jeji list userstate
*@
@foreach (var item in Model)
{
    @if (item.Value.Count > 0)
    {
    <h3>U tend to be in @item.Key.GetDisplayName() mood when u write about : </h3>
    }
    @if(item.Value.Count> 0)

        @foreach (var cislo in item.Value)
        {
            <p> @cislo  </p>
        }

    

}