@using System.ComponentModel.DataAnnotations
@using System.Reflection
@model MentalTrack.Models.MoodSummaryViewModel

<style>
    .AverageMood{
        border-radius: 2%;
        padding: 10px;
        margin-bottom: 50px;
        background: linear-gradient(135deg, #a8edea, #fed6e3)
    }


    .activities{
        border-radius: 2%;
        padding: 10px;
        margin-bottom:50px; 
        background: linear-gradient(135deg, #a8edea, #fed6e3)
    }

    .day{
        border-radius: 2%;
        padding: 10px;
        margin: 10px;
        background: linear-gradient(135deg, #9AD6AD, #fed6e3)
     
    }
    .week{
        border-radius: 2%;
        padding: 10px;
        margin:10px;
        background: linear-gradient(135deg, #a8edea, #fed6e3)
    }
    .page {
        max-width: 900px;
        margin: 0 auto;
        font-family: Arial, sans-serif;


    }

    h1 {
        margin-top: 10px;
        font-size: 30px;
        border-bottom: 2px solid #eee;
        padding-bottom: 10px;
        padding-top: 0px;

    }

    h3 {
        margin-top: 20px;
        font-size: 18px;
        color: #444;
    }

    .card {
        background: #fff;
        border: 1px solid #e6e6e6;
        border-radius: 10px;
        padding: 15px;
        margin-top: 10px;
        box-shadow: 0 2px 6px rgba(0,0,0,0.05);
    }

    ul {
        padding-left: 18px;
    }

    li {
        padding: 4px 0;
    }

    .tag {
        display: inline-block;
        padding: 2px 8px;
        border-radius: 6px;
        background: #f2f2f2;
        font-size: 12px;
        margin-left: 5px;
    }

    .grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 15px;
    }

    .small {
        color: #666;
        font-size: 13px;
    }

    .average-mood-card {
        max-width: 700px;
        margin: 40px auto;
        padding: 30px;
        border-radius: 18px;
        background: white;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
    }

        .average-mood-card h2 {
            margin-bottom: 25px;
            text-align: center;
            font-size: 2rem;
        }

    .stat {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 0;
        font-size: 1.2rem;
    }

    .stat strong {
        font-size: 1.4rem;
        color: #5b5bd6;
    }

    .average-mood-card hr {
        margin: 25px 0;
        border: none;
        height: 1px;
        background: #ddd;
    }

    .average-mood-card h3 {
        margin-bottom: 20px;
    }

    .mood-row {
        margin-bottom: 20px;
    }

    .mood-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 8px;
        font-weight: 600;
    }

    .progress {
        width: 100%;
        height: 16px;
        background: #ececec;
        border-radius: 100px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg,#7F7FD5,#86A8E7,#91EAE4);
        border-radius: 100px;
        transition: .5s;
    }

</style>

<div class="wholePage">
<div class="page">


    <div class="activities">
        <h1><img src="~/images/active-user.png" />  Activities and your mood</h1>
        <p> Mental Track looks for connections between what you write about and your mood. </p>
        @foreach (var item in Model.UserStatesMatches)
    {
        if (item.Value.Count > 0)
        {
            <div class="card">
                <h3>
                    You tend to be in <b>@item.Key.GetDisplayName()</b> mood when you write about:
                </h3>

                <ul>
                    @foreach (var state in item.Value)
                    {
                        <li>
                            <b>@state.Key.GetDisplayName()</b>
                            <span class="tag">@state.Value entry/entries</span>
                        </li>
                    }
                </ul>
            </div>
        }
    }
    </div>
    <div class="week">
        <h1><img src="~/images/next-week.png" />  Average mood in a week (based on days you wrote the entries)</h1>
        <p>
            Mental Track analyzes your mood from journal entries to show your average mood for each day of the week.
        </p>

    <div class="grid ">
        @foreach (var item in Model.DaysInTheWeekMatches)
        {
            var mood = (MoodEnum)item.Value;

            var display = mood.GetType()
                .GetField(mood.ToString())
                ?.GetCustomAttribute<DisplayAttribute>()
                ?.Name ?? mood.ToString();

            <div class="card">
                <b>@item.Key</b>
                <div class="small">@display</div>
            </div>
        }
    </div>

    </div>
    <div class="day">


        <h1><img src="~/images/clock.png" /> 
            Average mood in day phases, when you write the entries</h1>
            <p> 
                    Mental Track analyzes when you write your journal entries and shows your average mood during different parts of the day.

            </p>

    <div class="grid">
        @foreach (var item in Model.DayPhasesMatches)
        {
            var mood = (MoodEnum)item.Value;

            var display = mood.GetType()
                .GetField(mood.ToString())
                ?.GetCustomAttribute<DisplayAttribute>()
                ?.Name ?? mood.ToString();

            <div class="card">
                <b>@item.Key</b>
                <div class="small">@display</div>
            </div>
        }
    </div>
    </div>
    

        <div class="average-mood-card">
            <h2>Your Statistics</h2>

            <div class="stat">
                <span>Total entries</span>
                <strong>@Model.EntriesCount</strong>
            </div>

            <div class="stat">
                <span>Most common mood</span>
                <strong>@(((MoodEnum)Model.ModeMood).GetDisplayName())</strong>
            </div>

            <hr />

            <h3>Mood distribution</h3>

            @foreach (var item in Model.MoodPercentages)
            {
                <div class="mood-row">
                    <div class="mood-header">
                        <span>@item.Key.GetDisplayName()</span>
                        <span>@item.Value%</span>
                    </div>

                    <div class="progress">
                        <div class="progress-fill" style="width:@item.Value%"></div>
                    </div>
                </div>
            }
        </div>

</div>