@{
    ViewData["Title"] = "Home Page";
}

<head>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<div class="d-flex justify-content-center align-items-center min-vh-100 grass-background">

    <div class="book">

        <!-- STRÁNKA 1 -->
        <div class="page active" id="page1">

            <div class="card shadow-lg p-5 rounded-4">

                <div class="text-center mb-4">
                    <h1 class="display-4 fw-bold" style="color:green">
                        About Me
                    </h1>
                </div>

                <p class="lead text-secondary">
                    My name is Jan Bouza, and I am a junior developer.
                </p>

                <p class="text-muted">
                    MentalTrack was created out of a combination of my interest in mental health and my love of statistics.
                </p>

                <p class="text-muted">
                    I love the idea of using technology to help people better understand themselves, identify patterns in their lives, and gradually improve their well-being.
                </p>

                <p class="text-muted">
                    The app is currently free and ad-free, and I would love to keep it that way. However, to be honest, the costs of hosting and AI APIs have turned out to be higher than I initially expected. :D
                </p>

                <div class="text-center mt-4">

                    <button class="btn btn-success btn-lg" onclick="flip()">
                        Contact me
                    </button>

                </div>

            </div>

      

        </div>



        <!-- STRÁNKA 2 -->
        <div class="page" id="page2">

            <div class="card shadow-lg p-5 rounded-4">


                <div class="text-center mb-4">

                    <h1 class="display-4 fw-bold"
                        style="color:green">
                        Contact me
                    </h1>

                </div>


                <p class="lead text-secondary">
                    <strong> Email:</strong> janbouza5@seznam.cz
                </p>


                <p class="lead text-secondary">
                    <strong> Github: </strong> https://github.com/Bowsapy/MentalTrack
                </p>


                <p class="lead text-secondary">
                    <strong> Linekdin: </strong>  https://www.linkedin.com/in/jan-bouza-449863397/
                </p>



                <div class="text-center mt-4">

                    <button class="btn btn-success btn-lg" onclick="flip()">
                        About me
                    </button>

                </div>


            </div>

        </div>

       


    </div>

</div>





<style>





    .book {
        width: 720px;
        height: 600px;
        position: relative;
        perspective: 2000px;
    }

    @@media (max-width:576px) {
        .book {
            height: 750px;
        }
    }






    .page {
        position: absolute;
        width: 100%;
        height: 100%;
        transform-origin: left center;
        transition: transform .8s;
        backface-visibility: visible;
    }







        .page:not(.active) {
            display: none;
        }





    .card {
        height: 100%;
        background: url("/images/paper2.jpg") !important;
    }





    .flip {
        transform: rotateY(-180deg);
    }





    button:hover {
        transform: scale(1.05);
        transition: .2s;
    }

</style>





<script>

    //v podstate se p stisku tlacitka priradi page1 trida flip a po 400 s se z page1 odstrani trida active a page2 se priradi
     function flip(){

        let page1 = document.getElementById("page1");
        let page2 = document.getElementById("page2");
        let page3 = document.getElementById("page3");


        let activePage = document.querySelector(".page.active");


        if(activePage === page1){

            page1.classList.add("flip");

        }
        else if(activePage === page2){

            page2.classList.add("flip");

        }
        else{

            page3.classList.add("flip");

        }



        setTimeout(function(){


            if(activePage === page1){

                page1.classList.remove("active");
                page2.classList.add("active");

            }

            else if(activePage === page2){

                page2.classList.remove("active");
                page1.classList.add("active");
                    page1.classList.remove("flip");
                page2.classList.remove("flip");

            }

            else{

                page3.classList.remove("active");

                page1.classList.remove("flip");
                page2.classList.remove("flip");
                page3.classList.remove("flip");

                page1.classList.add("active");

            }


        },800);

    }


</script>