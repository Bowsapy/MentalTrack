@{
    ViewData["Title"] = "Home Page";
}
<head>

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />

</head>

<div class="d-flex justify-content-center align-items-center min-vh-100 grass-background">

    <div class="book">

        <!-- STRÁNKA 1 -->
        <div class="page active" id="page1">

            <div class="card shadow-lg p-5 rounded-4 paper-background">

                <div class="text-center mb-4">
                    <h1 class="display-4 fw-bold" style="color:green">
                        Welcome to Mental Track
                    </h1>
                </div>


                <p class="lead text-secondary">
                    Understand yourself better through your own thoughts and experiences.
                </p>


                <p class="text-muted">
                    <span class="fw-bold">Mental Track</span> 
                    is a <b> free</b> journaling and mood-tracking app designed to help you discover the triggers and causes behind your moods.
                </p>


                <p class="text-muted">
                    Simply write about your day, set your overall mood, and discover the habits, activities, and experiences that positively or negatively affect how you feel.
                </p>


        


                <div class="text-center mt-4">
                    <button class="btn btn-primary btn-lg"
                            onclick="flip()">
                        Next →
                    </button>
                </div>

            </div>

        </div>



        <!-- STRÁNKA 2 -->
        <div class="page" id="page2">

            <div class="card shadow-lg p-5 rounded-4">


                <div class="text-center mb-4">

                    <h1 class="display-4 fw-bold"
                        style="color:green">
                        Discover yourself
                    </h1>

                </div>


                <p class="lead text-secondary">
                    What exactly does Mental track offer?
                </p>


                <ul>
                    <li>
                        A free personal journal with secure data storage
                    </li>

                    <li>
                        Mood tracking with detailed statistics, including mood graphs
                        and average mood on a particular day of the week and day phase.
                    </li>

                    <li>
                        Mood analysis that identifies the activities and habits associated
                        with different moods, as well as the words you tend to use when
                        feeling a certain way (currently works only in english)
                    </li>
                </ul>
                <p> 
                    Just make an account and start your journey :)
                </p>

                <div class="text-center mt-4">

                    <a asp-controller="Diary"
                       asp-action="Create"
                       class="btn btn-success btn-lg">
                        Start your journey 🚀
                    </a>

                </div>


            </div>





        </div>

        <!-- STRÁNKA 2 -->
       


    </div>

</div>





<style>






    .book {
        width: 720px;
        height: 600px;
        position: relative;
        perspective: 2000px;
    }

    @@media (max-width:576px) {
        .book {
            height: 750px;
        }
    }






    .page {
        position: absolute;
        width: 100%;
        height: 100%;
        transform-origin: left center;
        transition: transform .8s ;
        backface-visibility: visible;
    }







        .page:not(.active) {
            display: none
         ;
        }





    .card {
        height: 100%;
        background: url("/images/paper2.jpg") !important;
    }





    .flip {
        transform: rotateY(-180deg);
    }





    button:hover {
        transform: scale(1.05);
        transition: .2s;
    }





</style>





<script>

    //v podstate se p stisku tlacitka priradi page1 trida flip a po 400 s se z page1 odstrani trida active a page2 se priradi
     function flip(){

        let page1 = document.getElementById("page1");
        let page2 = document.getElementById("page2");
        //let page3 = document.getElementById("page3");


        let activePage = document.querySelector(".page.active");
        

        if(activePage === page1){

            page1.classList.add("flip");

        }
        else if(activePage === page2){

            page2.classList.add("flip");

        }
        else{

            page3.classList.add("flip");

        }

        setTimeout(function(){


            if(activePage === page1){

                page1.classList.remove("active");

                page2.classList.add("active");

            }

            else if(activePage === page2){

                page2.classList.remove("active");
                page1.classList.add("active");
                page2.classList.remove("flip");
                page1.classList.remove("flip");



            }

            else{

                page3.classList.remove("active");

                page1.classList.remove("flip");
                page2.classList.remove("flip");
                page3.classList.remove("flip");

                page1.classList.add("active");

            }


        },800);

    }


</script>