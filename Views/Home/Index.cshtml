@{
    ViewData["Title"] = "Home Page";
}

<div class="d-flex justify-content-center align-items-center min-vh-100"
     style="    background: linear-gradient(135deg, #34d399, #10b981);
    ;">
    <div class="card shadow-lg p-5 rounded-4" style="max-width: 720px; width: 100%; transition: transform 0.3s;">
        <div class="text-center mb-4">
            <h1 class="display-4 fw-bold text-primary">Welcome to Mental Track</h1>
        </div>

        <div class="mb-4">
            <p class="lead text-secondary">
                Understand yourself better through your own thoughts and experiences.
            </p>

            <p class="text-muted mb-2">
                <span class="fw-bold">Mental Track</span> is a personal journaling app designed to help you reflect on your daily life,
                track your emotions, and discover connections between your habits, experiences, and mood.
            </p>

            <p class="text-muted mb-2">
                Write about your day, your thoughts, or anything that is on your mind.
                Over time, Mental Track analyzes your entries and helps you recognize patterns
                that may influence how you feel.
            </p>

            <p class="text-muted mb-2">
                By looking back at your experiences, you can gain a better understanding of yourself,
                identify what improves your mood, and become more aware of your personal growth.
            </p>

            <p class="text-muted fst-italic mb-0">
                Your thoughts are personal. Mental Track is here to help you reflect, learn, and grow.
            </p>
        </div>

        <div class="text-center mt-4">
            <a href="/Diary/Create" class="btn btn-primary btn-lg shadow-sm"
               style="transition: transform 0.2s;">
                <i class="bi bi-journal-text me-2"></i> Start Your First Entry
            </a>
        </div>
    </div>
</div>

<style>
    .card:hover {
        transform: translateY(-5px);
    }

    a.btn:hover {
        transform: scale(1.05);
    }
</style>